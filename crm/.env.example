# Supabase → Connect → ORMs → Prisma: скопируйте обе строки
# Через пулер (порт 6543) — для работы сайта
DATABASE_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Прямое подключение (порт 5432) — для создания таблиц
DIRECT_URL="postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Случайная длинная строка для подписи сессий
SESSION_SECRET="замените-на-случайную-строку"
# Первый пользователь с полным доступом (используется только в db:seed)
ADMIN_LOGIN="zhanetta"
ADMIN_CODE="придумайте-код"
ADMIN_NAME="Жанетта"
