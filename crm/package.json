  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "prisma": "6.19.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
